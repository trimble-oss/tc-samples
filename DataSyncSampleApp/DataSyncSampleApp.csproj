<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0-android</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('osx'))">$(TargetFrameworks);net8.0-ios</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>DataSyncSampleApp</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationTitle>PSet Sync Sample</ApplicationTitle>
    <ApplicationId>com.trimble.datasyncsample</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <AndroidCompileSdkVersion>34</AndroidCompileSdkVersion>
    <AndroidTargetSdkVersion>34</AndroidTargetSdkVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">11.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
    <AndroidEnableFastDeployment Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">false</AndroidEnableFastDeployment>
    <EmbedAssembliesIntoApk Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">true</EmbedAssembliesIntoApk>
    <CodesignKey Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">Apple Development</CodesignKey>
    <CodesignEntitlements Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">Platforms\iOS\Entitlements.plist</CodesignEntitlements>
    <RuntimeIdentifier Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">iossimulator-x64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#0066CC" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#0066CC" BaseSize="128,128" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="8.0.21" />
    <PackageReference Include="Trimble.Connect.Client" Version="2.8.2" />
    <PackageReference Include="Trimble.Connect.Client.Common" Version="2.0.2" />
    <PackageReference Include="Trimble.Identity.OAuth.AuthCode" Version="2.1.4" />
    <PackageReference Include="Trimble.Net.Http.Formatting" Version="1.1.1" />
    <PackageReference Include="Trimble.Connect.PSet.Client" Version="2.1.4" />
    <PackageReference Include="Trimble.Connect.SyncHelper.Client" Version="2.1.7" />
    <PackageReference Include="Trimble.SQLite" Version="2.0.12" />
    <!-- Single entry: pulls provider + native lib once. Extra lib/provider refs duplicate libe_sqlcipher.so → XA4301 / DllNotFound. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlcipher" Version="2.1.11" />
    <PackageReference Include="Trimble.Diagnostics" Version="3.0.9" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup Condition="$(TargetFramework.Contains('-android'))">
    <Reference Include="Trimble.Connect.Data">
      <HintPath>DataAndSyncDlls\droid\Data\Trimble.Connect.Data.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Trimble.Connect.Data.Sync">
      <HintPath>DataAndSyncDlls\droid\Sync\Trimble.Connect.Data.Sync.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup Condition="$(TargetFramework.Contains('-ios'))">
    <Reference Include="Trimble.Connect.Data">
      <HintPath>DataAndSyncDlls\netstandard2.0\Data\Trimble.Connect.Data.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Trimble.Connect.Data.Sync">
      <HintPath>DataAndSyncDlls\netstandard2.0\Sync\Trimble.Connect.Data.Sync.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup Condition="$(TargetFramework.Contains('-android'))">
    <AndroidManifest Include="AndroidManifest.xml" />
  </ItemGroup>

</Project>
