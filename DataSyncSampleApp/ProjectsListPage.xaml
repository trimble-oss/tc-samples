<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="DataSyncSampleApp.ProjectsListPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             Title="Projects"
             BackgroundColor="White">
    <Grid RowDefinitions="Auto,*" Padding="16" RowSpacing="12">
        <VerticalStackLayout Grid.Row="0" Spacing="8">
            <Label Text="Your Trimble Connect projects"
                   FontSize="18" FontAttributes="Bold"
                   TextColor="{StaticResource TrimbleBlue}" />
            <Button x:Name="RefreshButton" Text="Refresh" Clicked="OnRefreshClicked"
                    BackgroundColor="{StaticResource TrimbleBlue}" TextColor="White" CornerRadius="8" />
            <ActivityIndicator x:Name="Busy" IsRunning="False" IsVisible="False" />
        </VerticalStackLayout>
        <!-- SelectionMode + SelectionChanged is unreliable on Android with nested templates; use TapGestureRecognizer. -->
        <CollectionView x:Name="ProjectsList" Grid.Row="1" SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Stroke="#dddddd" StrokeThickness="1" Padding="14" Margin="0,6"
                            StrokeShape="RoundRectangle 8">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnProjectRowTapped" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{Binding Name}" FontAttributes="Bold" FontSize="16" />
                            <Label Text="{Binding Identifier}" FontSize="12" TextColor="{StaticResource SecondaryText}" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
