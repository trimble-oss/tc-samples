<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TCBrowserPro.Views.CreateTodoPage"
             Title="Create Todo"
             Shell.PresentationMode="ModalAnimated"
             BackgroundColor="{DynamicResource PageBackgroundColor}">
    
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">
            
            <!-- Title Section -->
            <Frame BackgroundColor="{DynamicResource CardBackgroundColor}" 
                   CornerRadius="10" 
                   Padding="15"
                   HasShadow="True">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Title *" 
                           FontAttributes="Bold" 
                           FontSize="14"
                           TextColor="{DynamicResource PrimaryTextColor}"/>
                    <Entry x:Name="TitleEntry"
                           Placeholder="Enter todo title"
                           PlaceholderColor="{DynamicResource PlaceholderColor}"
                           TextColor="{DynamicResource PrimaryTextColor}"
                           BackgroundColor="{DynamicResource EntryBackgroundColor}"
                           FontSize="16"/>
                </VerticalStackLayout>
            </Frame>

            <!-- Description Section -->
            <Frame BackgroundColor="{DynamicResource CardBackgroundColor}" 
                   CornerRadius="10" 
                   Padding="15"
                   HasShadow="True">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Description" 
                           FontAttributes="Bold" 
                           FontSize="14"
                           TextColor="{DynamicResource PrimaryTextColor}"/>
                    <Editor x:Name="DescriptionEditor"
                            Placeholder="Enter todo description (optional)"
                            PlaceholderColor="{DynamicResource PlaceholderColor}"
                            TextColor="{DynamicResource PrimaryTextColor}"
                            BackgroundColor="{DynamicResource EntryBackgroundColor}"
                            HeightRequest="120"
                            FontSize="16"
                            AutoSize="TextChanges"/>
                </VerticalStackLayout>
            </Frame>

            <!-- Priority Section -->
            <Frame BackgroundColor="{DynamicResource CardBackgroundColor}" 
                   CornerRadius="10" 
                   Padding="15"
                   HasShadow="True">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Priority" 
                           FontAttributes="Bold" 
                           FontSize="14"
                           TextColor="{DynamicResource PrimaryTextColor}"/>
                    <Picker x:Name="PriorityPicker"
                            Title="Select priority"
                            TextColor="{DynamicResource PrimaryTextColor}"
                            TitleColor="{DynamicResource PlaceholderColor}"
                            BackgroundColor="{DynamicResource EntryBackgroundColor}"
                            FontSize="16"
                            SelectedIndex="1">
                        <Picker.Items>
                            <x:String>Low</x:String>
                            <x:String>Normal</x:String>
                            <x:String>High</x:String>
                            <x:String>Critical</x:String>
                        </Picker.Items>
                    </Picker>
                </VerticalStackLayout>
            </Frame>

            <!-- Due Date Section -->
            <Frame BackgroundColor="{DynamicResource CardBackgroundColor}" 
                   CornerRadius="10" 
                   Padding="15"
                   HasShadow="True">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Due Date" 
                           FontAttributes="Bold" 
                           FontSize="14"
                           TextColor="{DynamicResource PrimaryTextColor}"/>
                    <DatePicker x:Name="DueDatePicker"
                                TextColor="{DynamicResource PrimaryTextColor}"
                                BackgroundColor="{DynamicResource EntryBackgroundColor}"
                                FontSize="16"
                                MinimumDate="{x:Static x:DateTime.Now}"
                                Date="{x:Static x:DateTime.Now}"/>
                </VerticalStackLayout>
            </Frame>

            <!-- Assignee Section (Optional) -->
            <Frame BackgroundColor="{DynamicResource CardBackgroundColor}" 
                   CornerRadius="10" 
                   Padding="15"
                   HasShadow="True">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Assignee (Optional)" 
                           FontAttributes="Bold" 
                           FontSize="14"
                           TextColor="{DynamicResource PrimaryTextColor}"/>
                    <Entry x:Name="AssigneeEntry"
                           Placeholder="Enter assignee email"
                           PlaceholderColor="{DynamicResource PlaceholderColor}"
                           TextColor="{DynamicResource PrimaryTextColor}"
                           BackgroundColor="{DynamicResource EntryBackgroundColor}"
                           Keyboard="Email"
                           FontSize="16"/>
                    <Label Text="Leave empty to assign to yourself" 
                           FontSize="12"
                           TextColor="{DynamicResource SecondaryTextColor}"
                           Margin="0,5,0,0"/>
                </VerticalStackLayout>
            </Frame>

            <!-- Buttons -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="15" Margin="0,10,0,20">
                <Button Grid.Column="0"
                        Text="Cancel"
                        BackgroundColor="#6C757D"
                        TextColor="White"
                        FontAttributes="Bold"
                        FontSize="16"
                        CornerRadius="10"
                        HeightRequest="50"
                        Clicked="OnCancelClicked"/>
                
                <Button Grid.Column="1"
                        Text="Create Todo"
                        BackgroundColor="#28A745"
                        TextColor="White"
                        FontAttributes="Bold"
                        FontSize="16"
                        CornerRadius="10"
                        HeightRequest="50"
                        Clicked="OnCreateClicked"/>
            </Grid>

        </VerticalStackLayout>
    </ScrollView>
    
</ContentPage>
