<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="TCBrowserPro.Maui.UserControls.FilesListView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:TCBrowserPro.Maui.UserControls"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:viewmodels="clr-namespace:TCBrowserPro.Maui.ViewModels"
    xmlns:converters="clr-namespace:TCBrowserPro.Maui.Converters"
    xmlns:local="clr-namespace:Trimble.Connect.Client.Models;assembly=Trimble.Connect.Client"
    x:Name="FilesListview"
    x:DataType="viewmodels:ProjectVm">
    <ContentView.Resources>
        <ResourceDictionary>
            <converters:FolderIconConverter x:Key="FolderIconConverter" />
        </ResourceDictionary>
    </ContentView.Resources>
    
    <VerticalStackLayout>
        <!-- Navigation Header -->
        <Frame Margin="5" Padding="10" BorderColor="DarkGray" CornerRadius="5" BackgroundColor="LightGray">
            <VerticalStackLayout>
                <HorizontalStackLayout>
                    <Button Text="← Back" 
                            Command="{Binding NavigateBackCommand}"
                            IsVisible="{Binding CanNavigateBack}"
                            FontSize="14"
                            BackgroundColor="DodgerBlue"
                            TextColor="White"
                            Margin="0,0,10,0"/>
                    <Label Text="{Binding BreadcrumbPath}" 
                           FontSize="16" 
                           FontAttributes="Bold"
                           VerticalOptions="Center"
                           HorizontalOptions="FillAndExpand"/>
                    <!-- CRUD Buttons -->
                    <Button Text="📤 Upload" 
                            Command="{Binding UploadFileCommand}"
                            FontSize="12"
                            BackgroundColor="Green"
                            TextColor="White"
                            Margin="5,0,0,0"
                            Padding="8,4"/>
                    <Button Text="📁 Folder" 
                            Command="{Binding CreateFolderCommand}"
                            FontSize="12"
                            BackgroundColor="Orange"
                            TextColor="White"
                            Margin="5,0,0,0"
                            Padding="8,4"/>
                </HorizontalStackLayout>
                <HorizontalStackLayout Margin="0,5,0,0">
                    <Label Text="{Binding FilesList.Count, StringFormat='Files loaded: {0}'}" 
                           FontSize="12" 
                           TextColor="DarkGray"
                           VerticalOptions="Center"/>
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </Frame>

        <!-- Files and Folders List -->
        <CollectionView ItemsSource="{Binding FilesList}"
                        SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="local:FolderItem">
                    <SwipeView>
                        <!-- Swipe actions for file operations -->
                        <SwipeView.RightItems>
                            <SwipeItems>
                                <SwipeItem Text="📥"
                                           BackgroundColor="Transparent"
                                           Command="{Binding Source={x:Reference FilesListview}, Path=BindingContext.DownloadFileCommand}"
                                           CommandParameter="{Binding .}"/>
                                <SwipeItem Text="✏️"
                                           BackgroundColor="Transparent"
                                           Command="{Binding Source={x:Reference FilesListview}, Path=BindingContext.RenameFileCommand}"
                                           CommandParameter="{Binding .}"/>
                                <SwipeItem Text="🗑️"
                                           BackgroundColor="Transparent"
                                           Command="{Binding Source={x:Reference FilesListview}, Path=BindingContext.DeleteFileCommand}"
                                           CommandParameter="{Binding .}"/>
                            </SwipeItems>
                        </SwipeView.RightItems>
                        
                        <Frame Margin="5" Padding="10" BorderColor="LightGray" CornerRadius="5">
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={x:Reference FilesListview}, Path=BindingContext.FolderTappedCommand}" 
                                                    CommandParameter="{Binding .}"/>
                            </Frame.GestureRecognizers>
                            
                            <HorizontalStackLayout>
                                <!-- Icon to differentiate folders from files -->
                                <Label Text="{Binding ., Converter={StaticResource FolderIconConverter}, ConverterParameter={Binding Source={x:Reference FilesListview}, Path=BindingContext}}"
                                       FontSize="24"
                                       FontFamily="Arial"
                                       VerticalOptions="Center"
                                       Margin="0,0,10,0"/>

                                <VerticalStackLayout HorizontalOptions="FillAndExpand" VerticalOptions="Center">
                                    <Label Text="{Binding Name}" 
                                           FontSize="16"
                                           FontAttributes="Bold"
                                           TextColor="Black"/>
                                    <Label Text="{Binding Size, StringFormat='Size: {0} bytes'}" 
                                           FontSize="12" 
                                           TextColor="Gray"/>
                                </VerticalStackLayout>
                            </HorizontalStackLayout>
                        </Frame>
                    </SwipeView>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            <CollectionView.EmptyView>
                <ContentView>
                    <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center">
                        <Label Text="No files found in this folder."
                               HorizontalOptions="Center"
                               FontSize="Large"
                               TextColor="Gray"/>
                        <Label Text="{Binding FilesList.Count, StringFormat='Items in collection: {0}'}"
                               HorizontalOptions="Center"
                               FontSize="Small"
                               TextColor="DarkGray"
                               Margin="0,10,0,0"/>
                    </VerticalStackLayout>
                </ContentView>
            </CollectionView.EmptyView>
        </CollectionView>
    </VerticalStackLayout>
</ContentView>
