<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <appSettings>
    <!-- All values are read by Config.cs; placeholders (e.g. &lt;ClientID&gt;) use defaults from Config.cs. Rebuild so bin\Debug gets this file. -->
    
    <!-- OAuth Authentication Settings -->
    <add key="AuthorityUrl" value="https://id.trimble.com/oauth/" />
    <!-- For staging: https://stage.id.trimblecloud.com/oauth/ -->
    
    <!-- Required: Get your Client ID from Trimble Developer Console (https://console.trimble.com/) -->
    <add key="ClientId" value="4438bfff-847d-11e6-904c-02f285fc0101" />
    
    <!-- Optional: Client secret (leave empty for public clients using PKCE) -->
    <add key="ClientKey" value="zldT0Op46kXwVp6_fBJzjEQ1VPga" />
    
    <!-- Optional: Application name (used for scope generation) -->
    <add key="AppName" value="TC.SDK.Example" />
    
    <!-- OAuth redirect URI (must match what's registered in Developer Console) -->
    <add key="RedirectUrl" value="http://localhost" />
    
    <!-- Trimble Connect API URLs -->
    <add key="OrgServiceUrl" value="https://org-api.us-east-1.connect.trimble.com/v1/" />
    <add key="PSetServiceUrl" value="https://pset-api.us-east-1.connect.trimble.com/v1/" />
    <add key="ConnectServiceUrl" value="https://app.connect.trimble.com/tc/api/2.0/" />
    
    <!-- Optional: Project ID (leave empty to select interactively) -->
    <add key="ProjectId" value="" />
  </appSettings>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <!-- Add assembly redirects if needed -->
      <dependentAssembly>
        <assemblyIdentity name="Newtonsoft.Json" publicKeyToken="30ad4fe6b2a6aeed" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-13.0.0.0" newVersion="13.0.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="Trimble.Diagnostics" publicKeyToken="33101ee013558559" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-3.0.0.0" newVersion="3.0.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="Trimble.Connect.Client" publicKeyToken="33101ee013558559" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-2.7.0.0" newVersion="2.7.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="Trimble.Connect.PSet.Client" publicKeyToken="33101ee013558559" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-2.1.0.0" newVersion="2.1.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Net.Http.Formatting" publicKeyToken="31bf3856ad364e35" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-6.0.0.0" newVersion="6.0.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="Trimble.Connect.Data" publicKeyToken="33101ee013558559" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-2.11.0.0" newVersion="2.11.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="Trimble.Connect.Data.Sync" publicKeyToken="33101ee013558559" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-2.11.0.0" newVersion="2.11.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Memory" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-4.0.5.0" newVersion="4.0.5.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Threading.Tasks.Extensions" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-4.2.4.0" newVersion="4.2.4.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Buffers" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-4.0.5.0" newVersion="4.0.5.0" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
</configuration>
