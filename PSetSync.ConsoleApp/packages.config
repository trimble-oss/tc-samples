  <package id="Trimble.SQLite" version="2.0.12" targetFramework="net48" />
  <!-- 
    SQLCipher native binaries (e_sqlcipher.dll). Managed Trimble.Connect.Data 2.11.0 does not embed these;
    Trimble.SQLite loads sqlite3.dll at runtime. Keep this package for packages.config projects so
    restore pulls the runtimes and Trimble.Connect.Data.targets (if present) can copy/rename them to
    bin\x64|x86\sqlite3.dll. Align SQLitePCLRaw.lib.e_sqlcipher version with the .targets in the
    Trimble.Connect.Data 2.11.0 package if release notes specify a different version.
  -->
  <package id="SQLitePCLRaw.lib.e_sqlcipher" version="2.1.11" targetFramework="net48" />
</packages>