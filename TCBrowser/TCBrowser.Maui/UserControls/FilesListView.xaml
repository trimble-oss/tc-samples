<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="TCBrowser.Maui.UserControls.FilesListView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:TCBrowser.Maui.UserControls"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:viewmodels="clr-namespace:TCBrowser.Maui.ViewModels"
    xmlns:local="clr-namespace:Trimble.Connect.Client.Models;assembly=Trimble.Connect.Client"
    x:Name="FilesListview"
    x:DataType="viewmodels:ProjectVm">
    
    <VerticalStackLayout>
        <!-- Navigation Header -->
        <Frame Margin="5" Padding="10" BorderColor="DarkGray" CornerRadius="5" BackgroundColor="LightGray">
            <VerticalStackLayout>
                <HorizontalStackLayout>
                    <Button Text="← Back" 
                            Command="{Binding NavigateBackCommand}"
                            IsVisible="{Binding CanNavigateBack}"
                            FontSize="14"
                            BackgroundColor="DodgerBlue"
                            TextColor="White"
                            Margin="0,0,10,0"/>
                    <Label Text="{Binding BreadcrumbPath}" 
                           FontSize="16" 
                           FontAttributes="Bold"
                           VerticalOptions="Center"/>
                </HorizontalStackLayout>
                <HorizontalStackLayout Margin="0,5,0,0">
                    <Label Text="{Binding FilesList.Count, StringFormat='Files loaded: {0}'}" 
                           FontSize="12" 
                           TextColor="DarkGray"
                           VerticalOptions="Center"/>
                    <Button Text="Debug" 
                            Command="{Binding DebugFilesCommand}"
                            FontSize="10"
                            BackgroundColor="Orange"
                            TextColor="White"
                            Margin="10,0,0,0"
                            Padding="5"/>
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </Frame>

        <!-- Files and Folders List -->
        <CollectionView ItemsSource="{Binding FilesList}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="local:FolderItem">
                    <Frame Margin="5" Padding="10" BorderColor="LightGray" CornerRadius="5">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Source={x:Reference FilesListview}, Path=BindingContext.FolderTappedCommand}" 
                                                CommandParameter="{Binding .}"/>
                        </Frame.GestureRecognizers>
                        
                        <HorizontalStackLayout>
                            <!-- Icon to differentiate folders from files -->
                            <Label Text="{Binding ., Converter={StaticResource FolderIconConverter}}"
                                   FontSize="20"
                                   FontFamily="Arial"
                                   VerticalOptions="Center"
                                   Margin="0,0,10,0"/>
                            
                            <VerticalStackLayout>
                                <Label Text="{Binding Name}"
                                       FontSize="Medium"
                                       FontAttributes="Bold"/>
                                <Label Text="{Binding ProjectIdentifier}" FontSize="12" />
                            </VerticalStackLayout>
                        </HorizontalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            <CollectionView.EmptyView>
                <ContentView>
                    <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center">
                        <Label Text="No files found in this folder."
                               HorizontalOptions="Center"
                               FontSize="Large"
                               TextColor="Gray"/>
                        <Label Text="{Binding FilesList.Count, StringFormat='Items in collection: {0}'}"
                               HorizontalOptions="Center"
                               FontSize="Small"
                               TextColor="DarkGray"
                               Margin="0,10,0,0"/>
                    </VerticalStackLayout>
                </ContentView>
            </CollectionView.EmptyView>
        </CollectionView>
    </VerticalStackLayout>
</ContentView>
