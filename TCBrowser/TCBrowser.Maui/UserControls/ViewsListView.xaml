<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="TCBrowser.Maui.UserControls.ViewsListView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:TCBrowser.Maui.UserControls"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:viewmodels="clr-namespace:TCBrowser.Maui.ViewModels"
    xmlns:local="clr-namespace:Trimble.Connect.Client.Models;assembly=Trimble.Connect.Client"
    x:Name="ViewsListview"
    x:DataType="viewmodels:ProjectVm">
    <CollectionView ItemsSource="{Binding ViewsList}">
        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="local:View">
                <Frame Margin="5" Padding="10" BorderColor="LightGray" CornerRadius="5">
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding Source={x:Reference ViewsListview}, Path=BindingContext.ViewTappedCommand}" 
                                            CommandParameter="{Binding .}"/>
                    </Frame.GestureRecognizers>
                    <HorizontalStackLayout>
                        <!-- Camera Icon -->
                        <Label Text="📷"
                               FontSize="20"
                               VerticalOptions="Center"
                               Margin="0,0,10,0"/>
                        
                        <Label Text="{Binding Name}" 
                               FontSize="Medium" 
                               FontAttributes="Bold"
                               VerticalOptions="Center"
                               VerticalTextAlignment="Center"/>
                    </HorizontalStackLayout>
                </Frame>
            </DataTemplate>
        </CollectionView.ItemTemplate>
        <CollectionView.EmptyView>
            <ContentView>
                <Label
                    FontSize="Large"
                    HorizontalOptions="Center"
                    Text="No views found."
                    TextColor="Gray"
                    VerticalOptions="Center" />
            </ContentView>
        </CollectionView.EmptyView>
    </CollectionView>
</ContentView>
